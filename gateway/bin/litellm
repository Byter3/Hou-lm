#!/usr/bin/env python
"""Run the ordinary LiteLLM CLI with the guarded stream repair installed.

Installation intentionally happens at module scope. Uvicorn's spawn workers
load this file as ``__mp_main__`` before importing their ASGI app; putting the
installation inside the main guard would leave those workers unpatched.
"""

from pathlib import Path
import sys


if "--run_granian" in sys.argv:
    print("Hou-lm stream repair requires the standard LiteLLM server launcher; "
          "Granian workers have not been verified.", file=sys.stderr, flush=True)
    raise SystemExit(78)

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
try:
    from litellm_stream_compat import install

    _houlm_version = install()
except Exception as _houlm_error:
    # Never continue unpatched or include upstream exception/request text.
    print("Hou-lm stream compatibility startup failed (%s)." %
          type(_houlm_error).__name__, file=sys.stderr, flush=True)
    raise SystemExit(78) from None

print("Hou-lm ChatGPT stream compatibility active (LiteLLM %s)." % _houlm_version,
      flush=True)
print("Hou-lm stream repair revision: streamfix2 (tool arguments and answer text).", flush=True)

if __name__ == "__main__":
    from litellm.proxy.proxy_cli import run_server

    run_server()
