<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="hou_lm" label="Hou-lm Assistant" icon="MISC_python" help_url="">
    <script><![CDATA[
from houlm import panel_host
import hou

_interface = None

def onCreateInterface():
    global _interface
    _interface = panel_host.PanelHost()
    kwargs["paneTab"].setLabel("Hou-lm Assistant")
    kwargs["paneTab"].showToolbar(False)
    return _interface

def onDestroyInterface():
    global _interface
    if _interface is not None:
        _interface.shutdown()
        _interface = None
]]></script>
    <includeInPaneTabMenu menu_position="100" create_separator="false"/>
    <includeInToolbarMenu menu_position="100" create_separator="false"/>
  </interface>
</pythonPanelDocument>
