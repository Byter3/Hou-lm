# Portainer: add these variables under the stack's Environment variables.
# For Docker Compose CLI on the VM: copy this file to .env and fill it in.
# Empty values intentionally fail Compose's required-variable checks.
# Never commit the populated .env file or real provider credentials.

# Generate a different value for each variable (e.g. openssl rand -hex 32).
# Prefix the master-key value with sk-.
LITELLM_MASTER_KEY=

# Keep this stable: it protects credentials already stored in PostgreSQL.
LITELLM_SALT_KEY=

# Use only letters and numbers because this is also used in DATABASE_URL.
LITELLM_DB_PASSWORD=
